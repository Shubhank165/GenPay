# GenPay Backend Environment Variables
# Copy this file to .env and update values

DATABASE_URL=postgresql+asyncpg://genpay:genpay_password@localhost:5432/genpay_db
DATABASE_URL_SYNC=postgresql://genpay:genpay_password@localhost:5432/genpay_db
SECRET_KEY=genpay-super-secret-key-change-in-production
DEBUG=true
AGENT_ENABLED=false
AGENT_API_KEY=your-agent-api-key-here
